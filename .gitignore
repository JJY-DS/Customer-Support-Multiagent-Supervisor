# ============================================
# .gitignore for Google Colab / Jupyter projects
# Focus: keep API keys and secrets out of Git
# ============================================

# ---------- Secrets & API keys ----------
.env
.env.*
!.env.example
*.env
secrets.json
secrets.yaml
secrets.yml
secret*.json
credentials.json
credentials*.json
client_secret*.json
service_account*.json
*serviceaccount*.json
token.json
token.pickle
*.pem
*.key
*.p12
*.pfx
api_keys.*
apikeys.*
config.local.*
.secrets/
secrets/

# Cloud provider credentials
.aws/
.azure/
.gcloud/
gcloud*.json
application_default_credentials.json

# Kaggle / Hugging Face / OpenAI style token files
kaggle.json
.kaggle/
.huggingface/
hf_token*
.openai
.netrc

# ---------- Colab / Jupyter ----------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
.jupyter/
sample_data/
drive/
/content/

# ---------- Python ----------
__pycache__/
*.py[cod]
*.so
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/
.python-version

# ---------- Data, models & outputs (often large or private) ----------
*.csv
*.parquet
*.h5
*.hdf5
*.pkl
*.pickle
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
data/
datasets/
models/
checkpoints/
outputs/
logs/
wandb/
mlruns/
runs/

# ---------- OS / editor clutter ----------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
